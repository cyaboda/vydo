PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DATA_DIR=data
# Optional with SQLite; required and identical across instances with PostgreSQL.
# Generate 32 random bytes as 64 hexadecimal characters. Never commit the result.
APP_SECRET=
# Use PostgreSQL for shared cloud quotas, sessions and profiles; migrate before enabling.
DATABASE_URL=
# Optional accounts. All values stay on the backend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_AUTH_ENABLED=false
# Only explicit proxy networks. Leave empty when connecting directly.
TRUSTED_PROXY_CIDRS=
# Optional protected administrative health endpoint; minimum 32 characters.
VYDO_ADMIN_TOKEN=
# Off by default. Supply all three only for an approved real provider.
AD_PROVIDER=
AD_IMAGE_URL=
AD_TARGET_URL=

# Enable only after configuring SMTP for public recipients; keep false for provider default test mail.
AUTH_PUBLIC_SIGNUP_ENABLED=false
